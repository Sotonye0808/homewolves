# ── Homewolves environment reference ──────────────────────────────────────
# Copy to .env and fill in real values. NEVER commit .env.
# Missing optional vars degrade gracefully (see notes below).

# ── Shared / Database ──────────────────────────────────────────────────────
# PostgreSQL connection string (required for API + Prisma CLI)
DATABASE_URL=postgresql://user:pass@localhost:5432/homewolves?schema=public

# JWT signing secret — MUST be set in production (fallback is dev-only)
JWT_SECRET=change-me

# ── Web (Next.js) ───────────────────────────────────────────────────────────
# Public base URLs (Vercel sets these per environment)
NEXT_PUBLIC_SITE_URL=https://homewolves.africa
NEXT_PUBLIC_API_URL=https://api.homewolves.africa/api/v1
NEXT_PUBLIC_WS_URL=wss://api.homewolves.africa

# ── API (NestJS) ────────────────────────────────────────────────────────────
PORT=4000
# Origin used for CORS + referral share links
WEB_URL=http://localhost:3000

# ── Paystack (subscriptions + featured listings) ────────────────────────────
# When PAYSTACK_SECRET_KEY is set, checkout/featured flows initialize real
# Paystack transactions and webhooks verify HMAC signatures. When unset the
# platform falls back to dev-mode links / auto-activation (fails gracefully).
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=https://homewolves.africa/dashboard

# ── DocuSeal (e-signatures) ─────────────────────────────────────────────────
# When both are set, signature requests create real DocuSeal submissions and
# embed the signing URL. When unset, requests fall back to the in-app flow.
DOCUSEAL_API_URL=https://docuseal.example.com
DOCUSEAL_API_KEY=

# ── Optional infra ──────────────────────────────────────────────────────────
# Redis-backed rate limiting is planned for multi-instance deployments
REDIS_URL=redis://localhost:6379
