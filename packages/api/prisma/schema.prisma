generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ─────────────────────────────────────────────────

enum UserRole {
  GUEST
  BUYER
  AGENT
  DEVELOPER
  HOMEOWNER
  ADMIN
  SUPER_ADMIN
}

enum ListingCategory {
  SALE
  RENT
  SHORTLET
  LAND
}

enum ListingStatus {
  DRAFT
  PENDING
  ACTIVE
  SUSPENDED
  SOLD
  RENTED
}

enum TransactionType {
  PURCHASE
  RENTAL
  SHORTLET
}

enum TransactionStatus {
  INITIATED
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

// ─── MODELS ────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  phone         String?   @unique
  firstName     String
  lastName      String
  avatar        String?
  role          UserRole
  verified      Boolean   @default(false)
  preferences   Json      @default("{}")
  referralCode  String?   @unique
  referredById  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ownedListings     Listing[]       @relation("listingOwner")
  agentListings     Listing[]       @relation("listingAgent")
  buyerTransactions Transaction[]   @relation("transactionBuyer")
  agentTransactions Transaction[]   @relation("transactionAgent")
  auditEvents       AuditEvent[]    @relation("actor")
  notifications     Notification[]
  sentMessages      Message[]
  agentClients      Client[]      @relation("agentClients")
  buyerClients      Client[]      @relation("buyerClients")
  createdNotes      Note[]        @relation("noteAuthor")
  createdRatings    Rating[]      @relation("ratingAuthor")
  createdInspections Inspection[] @relation("inspectionAuthor")

  @@index([role])
}

model Listing {
  id            String          @id @default(cuid())
  title         String
  description   String          @db.Text
  price         Decimal         @db.Decimal(18, 2)
  currency      String          @default("NGN")
  category      ListingCategory
  propertyType  String
  status        ListingStatus   @default(DRAFT)
  verified      Boolean         @default(false)
  featured      Boolean         @default(false)
  metadata      Json            @default("{}")
  locationJson  Json
  amenityIds    String[]
  ownerId       String
  agentId       String?
  viewCount     Int             @default(0)
  enquiryCount  Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  owner         User            @relation("listingOwner", fields: [ownerId], references: [id])
  agent         User?           @relation("listingAgent", fields: [agentId], references: [id])
  media         Media[]
  transactions  Transaction[]

  @@index([status])
  @@index([category])
  @@index([ownerId])
  @@index([agentId])
  @@index([createdAt])
}

model Media {
  id           String  @id @default(cuid())
  listingId    String
  url          String
  type         String  @default("image")
  altText      String?
  dominantColor String?
  width        Int?
  height       Int?
  isPrimary    Boolean @default(false)
  displayOrder Int     @default(0)

  listing      Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model Transaction {
  id            String            @id @default(cuid())
  listingId     String
  buyerId       String
  agentId       String
  type          TransactionType
  status        TransactionStatus @default(INITIATED)
  currentStep   Int               @default(0)
  stepsJson     Json
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  listing       Listing           @relation(fields: [listingId], references: [id])
  buyer         User              @relation("transactionBuyer", fields: [buyerId], references: [id])
  agent         User              @relation("transactionAgent", fields: [agentId], references: [id])
  documents     TransactionDocument[]
  payments      PaymentRecord[]

  @@index([listingId])
  @@index([buyerId])
  @@index([agentId])
  @@index([status])
}

model TransactionDocument {
  id              String       @id @default(cuid())
  transactionId   String
  name            String
  type            String
  url             String
  size            Int          @default(0)
  uploadedBy      String
  uploadedById    String
  visibility      String       @default("shared")
  virusScanStatus String       @default("pending")
  signedUrl       String?
  signedAt        DateTime?
  createdAt       DateTime     @default(now())

  transaction     Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([uploadedById])
}

model SignatureRequest {
  id            String         @id @default(cuid())
  transactionId String
  documentId    String?
  status        String         @default("pending")
  signerId      String
  signerEmail   String
  signerName    String
  embedUrl      String?
  externalId    String?
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  transaction   Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  document      TransactionDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([status])
}

model SubscriptionPlan {
  id            String      @id @default(cuid())
  name          String
  slug          String      @unique
  description   String
  price         Decimal     @db.Decimal(18, 2)
  currency      String      @default("NGN")
  interval      String      @default("monthly")
  features      Json
  limits        Json
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([slug])
  @@index([active])
}

model Subscription {
  id            String      @id @default(cuid())
  userId        String
  planId        String
  status        String      @default("active")
  paystackRef   String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId])
  @@index([status])
}

model PaymentRecord {
  id            String      @id @default(cuid())
  transactionId String
  amount        Decimal     @db.Decimal(18, 2)
  currency      String      @default("NGN")
  type          String
  status        String      @default("pending")
  evidenceUrl   String?
  confirmedBy   String?
  confirmedAt   DateTime?
  createdAt     DateTime    @default(now())

  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
}

model AuditEvent {
  id              String    @id @default(cuid())
  entityType      String
  entityId        String
  action          String
  actorId         String
  actorRole       String
  actorName       String
  ipAddress       String?
  deviceInfo      Json?
  metadata        Json      @default("{}")
  timestamp       DateTime  @default(now())

  actor           User      @relation("actor", fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([timestamp])
}

model PlatformConfig {
  id            String    @id @default(cuid())
  key           String    @unique
  value         Json
  updatedById   String
  updatedAt     DateTime  @updatedAt

  @@index([key])
}

model RecentlyViewed {
  id            String    @id @default(cuid())
  userId        String?
  sessionId     String?
  listingId     String
  viewedAt      DateTime  @default(now())

  @@index([userId])
  @@index([sessionId])
  @@index([listingId])
}

model SavedCollection {
  id            String    @id @default(cuid())
  userId        String
  name          String
  listingIds    String[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}

model Notification {
  id            String    @id @default(cuid())
  userId        String
  type          String
  title         String
  body          String
  data          Json?
  read          Boolean   @default(false)
  channel       String    @default("in_app")
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id])

  @@index([userId, read])
  @@index([createdAt])
}

model Message {
  id              String   @id @default(cuid())
  conversationId  String
  senderId        String
  content         String   @db.Text
  type            String   @default("text")
  mediaUrl        String?
  readAt          DateTime?
  createdAt       DateTime @default(now())

  sender          User     @relation(fields: [senderId], references: [id])
  conversation    Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@index([createdAt])
}

model Conversation {
  id              String    @id @default(cuid())
  propertyId      String?
  participantIds  String[]
  lastMessageAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  messages        Message[]

  @@index([participantIds])
}

model Client {
  id            String    @id @default(cuid())
  agentId       String
  buyerId       String
  status        String    @default("active")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  agent         User      @relation("agentClients", fields: [agentId], references: [id])
  buyer         User      @relation("buyerClients", fields: [buyerId], references: [id])
  notes         Note[]
  ratings       Rating[]
  inspections   Inspection[]

  @@index([agentId])
  @@index([buyerId])
  @@index([status])
}

model Note {
  id            String    @id @default(cuid())
  clientId      String
  content       String    @db.Text
  authorId      String
  createdAt     DateTime  @default(now())

  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author        User      @relation("noteAuthor", fields: [authorId], references: [id])

  @@index([clientId])
}

model Rating {
  id            String    @id @default(cuid())
  clientId      String
  score         Int
  review        String?   @db.Text
  authorId      String
  createdAt     DateTime  @default(now())

  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author        User      @relation("ratingAuthor", fields: [authorId], references: [id])

  @@index([clientId])
}

model Inspection {
  id            String    @id @default(cuid())
  clientId      String
  listingId     String
  scheduledAt   DateTime
  status        String    @default("scheduled")
  notes         String?   @db.Text
  authorId      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  listing       Listing   @relation(fields: [listingId], references: [id])
  author        User      @relation("inspectionAuthor", fields: [authorId], references: [id])

  @@index([clientId])
  @@index([listingId])
  @@index([scheduledAt])
  @@index([status])
}

model ActivityRule {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  points      Int
  category    String   @default("general")
  cooldownMs  Int?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  activities  AgentActivity[]

  @@index([key])
}

model AgentActivity {
  id          String   @id @default(cuid())
  agentId     String
  ruleId      String
  points      Int
  metadata    Json?
  createdAt   DateTime @default(now())

  agent       User     @relation("agentActivities", fields: [agentId], references: [id])
  rule        ActivityRule @relation(fields: [ruleId], references: [id])

  @@index([agentId])
  @@index([createdAt])
}

model AgentPoints {
  id          String   @id @default(cuid())
  agentId     String   @unique
  totalPoints Int      @default(0)
  tier        String   @default("bronze")
  updatedAt   DateTime @updatedAt

  agent       User     @relation("agentPoints", fields: [agentId], references: [id])

  @@index([totalPoints])
}

model BlogPost {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  excerpt       String    @db.Text
  content       String    @db.Text
  coverImage    String?
  authorId      String
  categories    String[]
  tags          String[]
  published     Boolean   @default(false)
  featured      Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  author        User      @relation("blogAuthor", fields: [authorId], references: [id])

  @@index([slug])
  @@index([published])
  @@index([featured])
  @@index([publishedAt])
  @@index([categories])
}
