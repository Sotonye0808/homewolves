{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@hw/types": ["../../packages/types/src"],
      "@/components/*": ["./components/*"],
      "@/lib/*": ["./lib/*"],
      "@/hooks/*": ["./hooks/*"],
      "@/config/*": ["./config/*"],
      "@/app/*": ["./app/*"]
    },
    "typeRoots": ["../../packages/types/src", "./node_modules/@types"],
    "types": []
  },
  "include": ["**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "../../packages/types/src/global.d.ts"],
  "exclude": ["node_modules"]
}
